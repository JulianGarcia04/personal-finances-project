{
  "description": "Manual LLM eval for chatWithAgent (scripts/agent-eval.mjs). Each case: question (Spanish), expectTools (tool names that must be called; 'a|b' accepts either), optional expectArgs (partial match on one call of that tool; '$group.key' resolves to fixture ids), optional history (prior turns), expectSuccess/forbidSuccess (write tools that must/must not succeed), expectAnswer (case-insensitive regex), optional expectNumbers (values computed at run time by running the named tool deterministically on the seeded fixture; the answer must mention each within ±1%). Mutating cases go last.",
  "cases": [
    { "id": "q01", "intent": "resumen del mes", "question": "Dame un resumen de mis gastos de este mes",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_month" }, "path": "totals.expenses" }] },
    { "id": "q02", "intent": "gasto total del mes", "question": "¿Cuánto he gastado en total este mes?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_month" }, "path": "totals.expenses" }] },
    { "id": "q03", "intent": "ingresos del mes", "question": "¿Cuánto dinero me entró este mes?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_month" }, "path": "totals.income" }] },
    { "id": "q04", "intent": "mes pasado", "question": "¿Cuánto gasté el mes pasado?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "last_month" }, "path": "totals.expenses" }] },
    { "id": "q05", "intent": "comparación mensual", "question": "Compara mis gastos de este mes con los del mes pasado",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [
        { "tool": "getFinancialSummary", "args": { "preset": "this_month", "compareWithPrevious": true }, "path": "totals.expenses" },
        { "tool": "getFinancialSummary", "args": { "preset": "this_month", "compareWithPrevious": true }, "path": "comparison.totals.expenses" }
      ] },
    { "id": "q06", "intent": "gastos de hoy", "question": "¿Cuánto llevo gastado hoy?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "today" }, "path": "totals.expenses" }] },
    { "id": "q07", "intent": "semana", "question": "¿Cuánto gasté esta semana?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_week" }, "path": "totals.expenses" }] },
    { "id": "q08", "intent": "año", "question": "¿Cuánto he ganado en lo que va del año?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_year" }, "path": "totals.income" }] },
    { "id": "q09", "intent": "categoría del mes", "question": "¿Cuánto gasté en comida este mes?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_month", "groupBy": "category" }, "path": "groups[key=$categories.food].expenses" }] },
    { "id": "q10", "intent": "gastos por categoría", "question": "Muéstrame mis gastos de este mes por categoría en una tabla",
      "expectTools": ["getFinancialSummary"],
      "expectArgs": [{ "tool": "getFinancialSummary", "args": { "groupBy": "category" } }],
      "expectNumbers": [
        { "tool": "getFinancialSummary", "args": { "preset": "this_month", "groupBy": "category" }, "path": "groups[key=$categories.food].expenses" },
        { "tool": "getFinancialSummary", "args": { "preset": "this_month", "groupBy": "category" }, "path": "groups[key=$categories.tech].expenses" }
      ] },
    { "id": "q11", "intent": "top gastos", "question": "¿Cuáles fueron mis 5 gastos más grandes este mes?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_month" }, "path": "topExpenses[0].amount" }] },
    { "id": "q12", "intent": "tasa de ahorro", "question": "¿Cuál es mi tasa de ahorro este mes?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_month" }, "path": "totals.savingsRate" }] },
    { "id": "q13", "intent": "promedio mensual", "question": "¿Cuál es mi gasto promedio mensual de los últimos 3 meses completos?",
      "expectTools": ["getFinancialSummary"],
      "expectArgs": [{ "tool": "getFinancialSummary", "args": { "lastCompleteMonths": 3 } }],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "lastCompleteMonths": 3 }, "path": "averages.expensesPerMonth" }] },
    { "id": "q14", "intent": "gastos por cuenta", "question": "¿Cuánto gasté este mes con la tarjeta Visa?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "preset": "this_month", "accountId": "$accounts.card" }, "path": "totals.expenses" }] },
    { "id": "q15", "intent": "rango de fechas", "question": "¿Cuánto gasté entre el 1 y el 7 de este mes?",
      "expectTools": ["getFinancialSummary"],
      "expectNumbers": [{ "tool": "getFinancialSummary", "args": { "startDate": "$month.day01", "endDate": "$month.day07" }, "path": "totals.expenses" }] },
    { "id": "q16", "intent": "patrimonio neto", "question": "¿Cuál es mi patrimonio neto actual?",
      "expectTools": ["listAccounts"],
      "expectNumbers": [{ "tool": "listAccounts", "args": {}, "path": "totals.netWorth" }] },
    { "id": "q17", "intent": "saldos", "question": "¿Cuánto tengo en cada una de mis cuentas?",
      "expectTools": ["listAccounts"],
      "expectNumbers": [{ "tool": "listAccounts", "args": {}, "path": "accounts[name=Banco Principal].balance" }] },
    { "id": "q18", "intent": "cupo tarjeta", "question": "¿Cuánto cupo disponible me queda en la tarjeta Visa?",
      "expectTools": ["listAccounts"],
      "expectNumbers": [{ "tool": "listAccounts", "args": {}, "path": "accounts[name=Visa].availableCredit" }] },
    { "id": "q19", "intent": "cuenta en dólares convertida", "question": "¿Cuánto vale en pesos lo que tengo en la cuenta en dólares?",
      "expectTools": ["listAccounts"],
      "expectNumbers": [{ "tool": "listAccounts", "args": {}, "path": "accounts[name=Cuenta USD].balanceInPrimary" }] },
    { "id": "q20", "intent": "bolsillos", "question": "¿Cuánto tengo ahorrado en el bolsillo del viaje?",
      "expectTools": ["listAccounts"],
      "expectNumbers": [{ "tool": "listAccounts", "args": {}, "path": "accounts[name=Bolsillo Viaje].balance" }] },
    { "id": "q21", "intent": "presupuesto del mes", "question": "¿Cómo voy con mis presupuestos este mes?",
      "expectTools": ["getWorkspaceSettings"],
      "expectNumbers": [{ "tool": "getWorkspaceSettings", "args": {}, "path": "currentMonth.categoryBudgets[categoryName=Comida].spent" }] },
    { "id": "q22", "intent": "límite de gasto", "question": "¿Cuánto me queda de mi límite de gasto mensual?",
      "expectTools": ["getWorkspaceSettings"],
      "expectNumbers": [{ "tool": "getWorkspaceSettings", "args": {}, "path": "currentMonth.expenseLimit.remaining" }] },
    { "id": "q23", "intent": "tasas de cambio", "question": "¿Qué tasa de cambio tengo configurada para el dólar?",
      "expectTools": ["getWorkspaceSettings"],
      "expectNumbers": [{ "tool": "getWorkspaceSettings", "args": {}, "path": "exchangeRates.USD" }] },
    { "id": "q24", "intent": "50/30/20", "question": "Según mi ingreso declarado, ¿cuánto debería destinar a necesidades con la regla 50/30/20?",
      "expectTools": ["getWorkspaceSettings"],
      "expectNumbers": [{ "tool": "getWorkspaceSettings", "args": {}, "path": "budgetSplit.needs.amount" }] },
    { "id": "q25", "intent": "últimos movimientos", "question": "Muéstrame mis últimos 5 movimientos",
      "expectTools": ["listTransactions"] },
    { "id": "q26", "intent": "transferencias entrantes", "question": "¿Qué movimientos tuvo el Bolsillo Viaje este mes?",
      "expectTools": ["listTransactions"],
      "expectArgs": [{ "tool": "listTransactions", "args": { "accountId": "$accounts.pocket" } }] },
    { "id": "q27", "intent": "préstamos", "question": "¿A quién le he prestado plata y cuánto me han devuelto?",
      "expectTools": ["listTransactions"] },
    { "id": "q28", "intent": "búsqueda semántica", "question": "¿Cuándo fue la última vez que cené en Miami?",
      "expectTools": ["semanticSearchTransactions"] },
    { "id": "q29", "intent": "metas", "question": "¿Cómo van mis metas de ahorro?",
      "expectTools": ["listGoals"] },
    { "id": "q30", "intent": "categorías", "question": "¿Qué categorías tengo configuradas?",
      "expectTools": ["listCategories"] },
    { "id": "q31", "intent": "impuestos (sin herramienta)", "question": "¿Qué es el 4x1000 y cómo me afecta?",
      "expectTools": [] },
    { "id": "q32", "intent": "propuesta de presupuestos", "question": "Ayúdame a crear presupuestos mensuales por categoría según mis gastos reales",
      "expectTools": ["getFinancialSummary"],
      "expectArgs": [{ "tool": "getFinancialSummary", "args": { "groupBy": "category" } }] },
    { "id": "q33", "intent": "eliminar pide confirmación", "question": "Elimina el gasto 'Mercado Éxito' de hoy",
      "expectTools": ["listTransactions|semanticSearchTransactions"],
      "forbidSuccess": ["deleteTransaction"],
      "expectAnswer": "confirm" },
    { "id": "q34", "intent": "gasto en cuenta puente", "question": "Registra un gasto de 30.000 pesos en la cuenta Gastos con Pareja por una cena",
      "expectTools": [],
      "forbidSuccess": ["createTransaction"] },
    { "id": "q35", "intent": "registrar gasto con fecha relativa", "question": "Ayer gasté 20.000 pesos en taxi, pagué en efectivo. Regístralo.",
      "expectTools": ["createTransaction"],
      "expectArgs": [{ "tool": "createTransaction", "args": { "accountId": "$accounts.cash", "type": "expense", "amount": 20000, "date": "$dates.yesterday" } }],
      "expectSuccess": ["createTransaction"] },
    { "id": "q36", "intent": "registrar préstamo", "question": "Le presté 50.000 pesos a Ana desde el Banco Principal hoy. Regístralo.",
      "expectTools": ["createTransaction"],
      "expectArgs": [{ "tool": "createTransaction", "args": { "accountId": "$accounts.bank", "type": "loan", "amount": 50000 } }] },
    { "id": "q37", "intent": "crear meta", "question": "Crea una meta de ahorro 'Carro' de 40.000.000 COP para el 31 de diciembre del próximo año",
      "expectTools": ["createGoal"],
      "expectArgs": [{ "tool": "createGoal", "args": { "targetAmount": 40000000, "currency": "COP" } }],
      "expectSuccess": ["createGoal"] },
    { "id": "q38", "intent": "eliminar tras confirmar (dos turnos)", "question": "Sí, elimínalo",
      "history": [
        { "role": "user", "content": "Elimina el gasto 'Mercado Éxito' de hoy" },
        { "role": "assistant", "content": "Encontré este gasto de hoy: **Mercado Éxito**, -200.000 COP en Banco Principal (Comida). ¿Confirmas que quieres eliminarlo?" }
      ],
      "expectTools": ["deleteTransaction"],
      "expectArgs": [{ "tool": "deleteTransaction", "args": { "confirmed": true } }],
      "expectSuccess": ["deleteTransaction"] }
  ]
}
