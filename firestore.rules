rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para comprobar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar para comprobar si el documento pertenece al usuario autenticado (legado/personal)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Función auxiliar para comprobar si el usuario pertenece al workspace
    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
    }

    // Reglas para la colección de Usuarios
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      
      // Subcolección segura para API Keys y configs sensibles
      match /secure/{documentId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reglas para la nueva colección de Workspaces
    match /workspaces/{workspaceId} {
      // Cualquier usuario puede crear un workspace, siempre y cuando se agregue a sí mismo como miembro
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      // Los miembros pueden leer y actualizar el workspace (ej. invitar otros)
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.members;
      // Solo el dueño puede eliminar el workspace
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Reglas para la colección de Cuentas
    match /accounts/{accountId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    // References use the actual post-state parent, not membership in either workspace alone.
    function isTransactionBudgetParentAfter(data, allowArchived) {
      let budgetPath = /databases/$(database)/documents/budgets/$(data.budgetId);
      return existsAfter(budgetPath) &&
        getAfter(budgetPath).data.workspaceId == data.workspaceId &&
        getAfter(budgetPath).data.archived is bool &&
        (allowArchived || getAfter(budgetPath).data.archived == false);
    }

    function isValidTransactionBudget(data, allowArchived) {
      return !('budgetId' in data) || data.budgetId == null ||
        (data.type == 'expense' && data.budgetId is string &&
          data.budgetId.size() > 0 && data.budgetId.size() <= 1500 &&
          data.budgetId.matches('^[^/]+$') && !(data.budgetId in ['.', '..']) &&
          (data.budgetId == 'default-monthly' || isTransactionBudgetParentAfter(data, allowArchived)));
    }

    function isValidTransactionBudgetUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['workspaceId']) &&
        (!changed.hasAny(['budgetId']) || changed.hasOnly(['budgetId'])) &&
        isValidTransactionBudget(request.resource.data, !changed.hasAny(['budgetId']));
    }

    // Existing reads/deletes remain member-scoped; classification changes never edit ledger fields.
    match /transactions/{transactionId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId) &&
        isValidTransactionBudget(request.resource.data, false);
      allow update: if isWorkspaceMember(resource.data.workspaceId) && isValidTransactionBudgetUpdate();
      allow delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    // Reglas para la colección de Categorías
    match /categories/{categoryId} {
      // Permitir leer si el usuario pertenece al workspace,
      // o si es una categoría global por defecto (workspaceId == null)
      allow read: if isAuthenticated() && (resource.data.workspaceId == null || isWorkspaceMember(resource.data.workspaceId));
      
      // Solo permitir crear/editar categorías personalizadas para el workspace
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    // Reglas para la colección de Objetivos/Metas de Ahorro
    match /goals/{goalId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    // Reglas para la colección de Chats de IA
    match /chats/{chatId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    // Additional operating budgets; the default monthly baseline remains in workspace settings.
    function hasBudgetFields(data) {
      return data.keys().hasAll([
        'workspaceId', 'kind', 'name', 'capCurrency', 'archived', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'workspaceId', 'kind', 'name', 'capCurrency', 'totalLimit', 'archived',
        'createdAt', 'updatedAt', 'startDate', 'endDate'
      ]);
    }

    // Subtracting a number from itself yields zero only for finite values (including large finite doubles).
    function isFiniteNonnegative(value) {
      return value is number && value >= 0 && value - value == 0;
    }

    function hasValidBudgetPlanningDates(data) {
      return (data.kind == 'monthly' && !('startDate' in data) && !('endDate' in data)) ||
        (data.kind == 'event' &&
          (!('startDate' in data) || data.startDate is timestamp) &&
          (!('endDate' in data) || data.endDate is timestamp) &&
          (!('startDate' in data) || !('endDate' in data) || data.endDate >= data.startDate));
    }

    function isValidBudgetRecord(data, budgetId) {
      return budgetId != 'default-monthly' && hasBudgetFields(data) &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 1500 &&
        data.kind in ['monthly', 'event'] &&
        data.name is string && data.name.matches('.*\\S.*') && data.name.size() <= 100 &&
        data.capCurrency is string && data.capCurrency.matches('^[A-Z]{3}$') &&
        (!('totalLimit' in data) || isFiniteNonnegative(data.totalLimit)) &&
        data.archived is bool && data.createdAt is timestamp && data.updatedAt is timestamp &&
        hasValidBudgetPlanningDates(data);
    }

    function isValidBudgetCreate(data, budgetId) {
      return isValidBudgetRecord(data, budgetId) && data.archived == false &&
        data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isValidBudgetUpdate(data, budgetId) {
      return isValidBudgetRecord(data, budgetId) &&
        data.workspaceId == resource.data.workspaceId && data.kind == resource.data.kind &&
        data.capCurrency == resource.data.capCurrency && data.createdAt == resource.data.createdAt &&
        data.updatedAt == request.time &&
        ((!resource.data.archived && !data.archived &&
          data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'totalLimit', 'startDate', 'endDate', 'updatedAt'
          ])) ||
         (!resource.data.archived && data.archived &&
          data.diff(resource.data).affectedKeys().hasOnly(['archived', 'updatedAt'])));
    }

    function isCurrentBudgetWorkspaceMember(budgetId) {
      let budgetPath = /databases/$(database)/documents/budgets/$(budgetId);
      return budgetId != 'default-monthly' && exists(budgetPath) &&
        isWorkspaceMember(get(budgetPath).data.workspaceId);
    }

    function isActiveBudgetWorkspaceMemberAfter(budgetId) {
      let budgetPath = /databases/$(database)/documents/budgets/$(budgetId);
      return budgetId != 'default-monthly' && existsAfter(budgetPath) &&
        getAfter(budgetPath).data.archived == false &&
        isWorkspaceMember(getAfter(budgetPath).data.workspaceId);
    }

    function hasValidCategoryCapAmount(data) {
      return data.keys().hasAll(['amount']) && data.keys().hasOnly(['amount']) &&
        isFiniteNonnegative(data.amount);
    }

    function isExpenseCategoryForBudgetAfter(budgetId, categoryId) {
      let budgetPath = /databases/$(database)/documents/budgets/$(budgetId);
      let categoryPath = /databases/$(database)/documents/categories/$(categoryId);
      return existsAfter(budgetPath) && existsAfter(categoryPath) &&
        ('workspaceId' in getAfter(categoryPath).data) &&
        getAfter(categoryPath).data.type in ['expense', 'both'] &&
        (getAfter(categoryPath).data.workspaceId == null ||
          getAfter(categoryPath).data.workspaceId == getAfter(budgetPath).data.workspaceId);
    }

    match /budgets/{budgetId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId) &&
        isValidBudgetCreate(request.resource.data, budgetId);
      allow update: if isWorkspaceMember(resource.data.workspaceId) &&
        isValidBudgetUpdate(request.resource.data, budgetId);
      allow delete: if false;

      // Child caps inherit denomination and workspace from their actual parent.
      // Reads retain archived/orphan history; every mutation requires the active post-state.
      match /categoryCaps/{categoryId} {
        allow read: if isCurrentBudgetWorkspaceMember(budgetId);
        allow create, update: if isActiveBudgetWorkspaceMemberAfter(budgetId) &&
          hasValidCategoryCapAmount(request.resource.data) &&
          isExpenseCategoryForBudgetAfter(budgetId, categoryId);
        allow delete: if isActiveBudgetWorkspaceMemberAfter(budgetId);
      }
    }
  }
}
