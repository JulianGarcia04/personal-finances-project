rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() &&
        workspaceId is string &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
    }

    function accountPath(accountId) {
      return /databases/$(database)/documents/accounts/$(accountId);
    }

    function transactionPath(transactionId) {
      return /databases/$(database)/documents/transactions/$(transactionId);
    }

    function hasNoParent(data) {
      return !('parentAccountId' in data) || data.parentAccountId == null;
    }

    function childIds(data) {
      return 'childAccountIds' in data ? data.childAccountIds : [];
    }

    function validChildIds(ids) {
      return ids is list && ids.size() == ids.toSet().size();
    }

    function isFiniteNumber(value) {
      return value is number && value == value && value - value == 0;
    }

    function rootAccountForWorkspace(accountId, workspaceId) {
      let account = get(accountPath(accountId));
      return account != null && account.data.workspaceId == workspaceId && hasNoParent(account.data) &&
        validChildIds(childIds(account.data)) && childIds(account.data).size() == 0;
    }

    function rootAccountAfterForWorkspace(accountId, workspaceId) {
      let account = getAfter(accountPath(accountId));
      return account != null && account.data.workspaceId == workspaceId && hasNoParent(account.data);
    }

    function validPocketOpeningLink(transactionId, parentId, childId, amount, workspaceId, currency) {
      let tx = getAfter(transactionPath(transactionId));
      return transactionId is string &&
        tx != null &&
        tx.data.pocketAllocation == true &&
        tx.data.workspaceId == workspaceId &&
        tx.data.userId == request.auth.uid &&
        tx.data.accountId == parentId &&
        tx.data.toAccountId == childId &&
        tx.data.type == 'transfer' &&
        tx.data.amount == amount &&
        tx.data.currency == currency &&
        tx.data.categoryId == '' &&
        tx.data.description is string &&
        tx.data.date is timestamp &&
        tx.data.createdAt is timestamp;
    }

    function validPocketCreate(accountId) {
      let data = request.resource.data;
      let parentId = data.parentAccountId;
      let parent = get(accountPath(parentId));
      let parentAfter = getAfter(accountPath(parentId));
      let amount = data.balance;
      let isFunded = amount > 0;
      return isAuthenticated() &&
        parentId is string && parentId != accountId &&
        data.workspaceId is string && isWorkspaceMember(data.workspaceId) &&
        data.userId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.type == 'savings' &&
        isFiniteNumber(amount) && amount >= 0 &&
        data.limit == 0 &&
        (!('statementClosingDay' in data) || data.statementClosingDay == null) &&
        (!('paymentDueDay' in data) || data.paymentDueDay == null) &&
        (!('mirror' in data) || data.mirror == null) &&
        data.currency is string &&
        data.pocketActivity is bool && data.pocketActivity == isFunded &&
        data.openingAllocationId == (isFunded ? data.openingAllocationId : null) &&
        (!isFunded || data.openingAllocationId is string) &&
        (!('childAccountIds' in data) || (data.childAccountIds is list && data.childAccountIds.size() == 0)) &&
        data.createdAt is timestamp &&
        parent != null && parentAfter != null &&
        parent.data.workspaceId == data.workspaceId &&
        parent.data.type in ['checking', 'savings'] && hasNoParent(parent.data) &&
        (!('mirror' in parent.data) || parent.data.mirror == null) &&
        parent.data.currency == data.currency &&
        isFiniteNumber(parent.data.balance) && parent.data.balance >= amount &&
        validChildIds(childIds(parent.data)) &&
        validChildIds(childIds(parentAfter.data)) &&
        accountId in childIds(parentAfter.data) &&
        parentAfter.data.lastPocketChildId == accountId &&
        parentAfter.data.lastPocketChange == 'created' &&
        (isFunded
          ? parentAfter.data.balance == parent.data.balance - amount &&
            validPocketOpeningLink(data.openingAllocationId, parentId, accountId, amount, data.workspaceId, data.currency)
          : amount == 0 && data.openingAllocationId == null && data.pocketActivity == false &&
            parentAfter.data.balance == parent.data.balance);
    }

    function validPocketAddition(accountId, oldIds, newIds, changed) {
      let childId = request.resource.data.lastPocketChildId;
      let child = getAfter(accountPath(childId));
      let amount = child.data.balance;
      let isFunded = amount > 0;
      return request.resource.data.lastPocketChange == 'created' &&
        childId is string && childId in newIds && !(childId in oldIds) &&
        newIds.size() == oldIds.size() + 1 && newIds.hasAll(oldIds) &&
        validChildIds(newIds) &&
        changed.hasOnly(['balance', 'childAccountIds', 'lastPocketChildId', 'lastPocketChange']) &&
        child != null && child.data.parentAccountId == accountId &&
        child.data.workspaceId == resource.data.workspaceId &&
        child.data.currency == resource.data.currency &&
        child.data.type == 'savings' && isFiniteNumber(amount) && amount >= 0 &&
        (isFunded
          ? request.resource.data.balance == resource.data.balance - amount && resource.data.balance >= amount &&
            child.data.openingAllocationId is string &&
            validPocketOpeningLink(child.data.openingAllocationId, accountId, childId, amount, resource.data.workspaceId, resource.data.currency)
          : amount == 0 && request.resource.data.balance == resource.data.balance &&
            child.data.openingAllocationId == null && child.data.pocketActivity == false);
    }

    function validPocketRemoval(accountId, oldIds, newIds, changed) {
      let childId = request.resource.data.lastPocketChildId;
      let child = get(accountPath(childId));
      let childAfter = getAfter(accountPath(childId));
      return request.resource.data.lastPocketChange == 'deleted' &&
        childId is string && childId in oldIds && !(childId in newIds) &&
        oldIds.size() == newIds.size() + 1 && oldIds.hasAll(newIds) &&
        validChildIds(newIds) &&
        changed.hasOnly(['childAccountIds', 'lastPocketChildId', 'lastPocketChange']) &&
        child != null && childAfter == null &&
        child.data.parentAccountId == accountId &&
        child.data.workspaceId == resource.data.workspaceId &&
        child.data.currency == resource.data.currency &&
        child.data.balance == 0 && child.data.pocketActivity == false &&
        child.data.openingAllocationId == null &&
        request.resource.data.balance == resource.data.balance;
    }

    function validRootAccountUpdate(accountId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldIds = childIds(resource.data);
      let newIds = childIds(request.resource.data);
      let registryChanged = changed.hasAny(['childAccountIds', 'lastPocketChildId', 'lastPocketChange']);
      return hasNoParent(resource.data) && hasNoParent(request.resource.data) &&
        !changed.hasAny(['parentAccountId']) &&
        !('pocketActivity' in request.resource.data) &&
        !('openingAllocationId' in request.resource.data) &&
        (oldIds.size() == 0 || request.resource.data.workspaceId == resource.data.workspaceId) &&
        validChildIds(oldIds) && validChildIds(newIds) &&
        (oldIds.size() == 0 ||
          (request.resource.data.type == resource.data.type &&
           request.resource.data.currency == resource.data.currency &&
           (!('mirror' in request.resource.data) || request.resource.data.mirror == null) &&
           (!('mirror' in resource.data) || resource.data.mirror == null))) &&
        (registryChanged
          ? validPocketAddition(accountId, oldIds, newIds, changed) ||
            validPocketRemoval(accountId, oldIds, newIds, changed)
          : oldIds.size() == newIds.size() && newIds.hasAll(oldIds) && oldIds.hasAll(newIds) &&
            (oldIds.size() == 0 || request.resource.data.balance == resource.data.balance));
    }

    function validPocketUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.parentAccountId == resource.data.parentAccountId &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.type == 'savings' && resource.data.type == 'savings' &&
        request.resource.data.balance == resource.data.balance &&
        request.resource.data.limit == resource.data.limit &&
        request.resource.data.pocketActivity == resource.data.pocketActivity &&
        request.resource.data.openingAllocationId == resource.data.openingAllocationId &&
        (!('mirror' in request.resource.data) || request.resource.data.mirror == null) &&
        changed.hasOnly(['name']);
    }

    function validPocketDelete(accountId) {
      let parentId = resource.data.parentAccountId;
      let parentAfter = getAfter(accountPath(parentId));
      return parentId is string &&
        resource.data.balance == 0 &&
        resource.data.pocketActivity == false &&
        resource.data.openingAllocationId == null &&
        parentAfter != null &&
        parentAfter.data.workspaceId == resource.data.workspaceId &&
        !(accountId in childIds(parentAfter.data)) &&
        parentAfter.data.lastPocketChildId == accountId &&
        parentAfter.data.lastPocketChange == 'deleted';
    }

    function normalTransactionReferencesRoots(data) {
      return data.accountId is string && rootAccountForWorkspace(data.accountId, data.workspaceId) &&
        !('pocketAllocation' in data) &&
        (data.toAccountId == null ||
          (data.toAccountId is string && rootAccountForWorkspace(data.toAccountId, data.workspaceId)));
    }

    function safeExistingTransactionReferencesNoPocket(data) {
      let sourceExists = exists(accountPath(data.accountId));
      let destinationExists = data.toAccountId is string && exists(accountPath(data.toAccountId));
      return (!sourceExists || rootAccountForWorkspace(data.accountId, data.workspaceId)) &&
        (!destinationExists || rootAccountForWorkspace(data.toAccountId, data.workspaceId));
    }

    function validPocketOpeningTransaction(transactionId) {
      let data = request.resource.data;
      let parentId = data.accountId;
      let childId = data.toAccountId;
      let parent = get(accountPath(parentId));
      let parentAfter = getAfter(accountPath(parentId));
      let childAfter = getAfter(accountPath(childId));
      return data.pocketAllocation == true &&
        data.type == 'transfer' && data.workspaceId is string &&
        data.userId == request.auth.uid &&
        data.accountId is string && data.toAccountId is string && data.accountId != data.toAccountId &&
        isFiniteNumber(data.amount) && data.amount > 0 &&
        data.categoryId == '' && data.currency is string &&
        data.description is string && data.date is timestamp && data.createdAt is timestamp &&
        parent != null && parentAfter != null && childAfter != null &&
        parent.data.workspaceId == data.workspaceId && parent.data.currency == data.currency &&
        parent.data.type in ['checking', 'savings'] && hasNoParent(parent.data) &&
        (!('mirror' in parent.data) || parent.data.mirror == null) &&
        parent.data.balance >= data.amount &&
        parentAfter.data.balance == parent.data.balance - data.amount &&
        parentAfter.data.lastPocketChildId == childId && parentAfter.data.lastPocketChange == 'created' &&
        childId in childIds(parentAfter.data) &&
        childAfter.data.parentAccountId == parentId &&
        childAfter.data.workspaceId == data.workspaceId &&
        childAfter.data.currency == data.currency &&
        childAfter.data.balance == data.amount &&
        childAfter.data.pocketActivity == true &&
        childAfter.data.openingAllocationId == transactionId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /secure/{documentId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /workspaces/{workspaceId} {
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /accounts/{accountId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId) &&
        (hasNoParent(request.resource.data)
          ? ((!('childAccountIds' in request.resource.data) ||
              (request.resource.data.childAccountIds is list && request.resource.data.childAccountIds.size() == 0)) &&
             !('pocketActivity' in request.resource.data) &&
             !('openingAllocationId' in request.resource.data) &&
             !('lastPocketChildId' in request.resource.data) &&
             !('lastPocketChange' in request.resource.data))
          : validPocketCreate(accountId));
      allow update: if isWorkspaceMember(resource.data.workspaceId) &&
        (hasNoParent(resource.data) ? validRootAccountUpdate(accountId) : validPocketUpdate());
      allow delete: if isWorkspaceMember(resource.data.workspaceId) &&
        (hasNoParent(resource.data)
          ? validChildIds(childIds(resource.data)) && childIds(resource.data).size() == 0
          : validPocketDelete(accountId));
    }

    match /transactions/{transactionId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId) &&
        (normalTransactionReferencesRoots(request.resource.data) ||
         validPocketOpeningTransaction(transactionId));
      allow update: if isWorkspaceMember(resource.data.workspaceId) &&
        isWorkspaceMember(request.resource.data.workspaceId) &&
        safeExistingTransactionReferencesNoPocket(resource.data) &&
        safeExistingTransactionReferencesNoPocket(request.resource.data);
      allow delete: if isWorkspaceMember(resource.data.workspaceId) &&
        safeExistingTransactionReferencesNoPocket(resource.data);
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated() &&
        (resource.data.workspaceId == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    match /goals/{goalId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    match /chats/{chatId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }
  }
}
