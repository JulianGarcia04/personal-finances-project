rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() &&
        workspaceId is string &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
    }

    function accountPath(accountId) {
      return /databases/$(database)/documents/accounts/$(accountId);
    }

    function transactionPath(transactionId) {
      return /databases/$(database)/documents/transactions/$(transactionId);
    }

    function hasNoParent(data) {
      return !('parentAccountId' in data) || data.parentAccountId == null;
    }

    function childIds(data) {
      return 'childAccountIds' in data ? data.childAccountIds : [];
    }

    function validChildIds(ids) {
      return ids is list && ids.size() == ids.toSet().size();
    }

    function isFiniteNumber(value) {
      return value is number && value == value && value - value == 0;
    }

    function rootAccountForWorkspace(accountId, workspaceId) {
      let account = get(accountPath(accountId));
      return account != null && account.data.workspaceId == workspaceId && hasNoParent(account.data) &&
        validChildIds(childIds(account.data)) && childIds(account.data).size() == 0;
    }

    function validPocketOpeningLink(transactionId, parentId, childId, amount, workspaceId, currency) {
      let tx = getAfter(transactionPath(transactionId));
      return transactionId is string &&
        tx != null &&
        tx.data.pocketAllocation == true &&
        tx.data.workspaceId == workspaceId &&
        tx.data.userId == request.auth.uid &&
        tx.data.accountId == parentId &&
        tx.data.toAccountId == childId &&
        tx.data.type == 'transfer' &&
        tx.data.amount == amount &&
        tx.data.currency == currency &&
        tx.data.categoryId == '' &&
        tx.data.description is string &&
        tx.data.date is timestamp &&
        tx.data.createdAt is timestamp;
    }

    function validPocketCreate(accountId) {
      let data = request.resource.data;
      let parentId = data.parentAccountId;
      let parent = get(accountPath(parentId));
      let parentAfter = getAfter(accountPath(parentId));
      let amount = data.balance;
      let isFunded = amount > 0;
      return isAuthenticated() &&
        parentId is string && parentId != accountId &&
        data.workspaceId is string && isWorkspaceMember(data.workspaceId) &&
        data.userId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.type == 'savings' &&
        isFiniteNumber(amount) && amount >= 0 &&
        data.limit == 0 &&
        (!('statementClosingDay' in data) || data.statementClosingDay == null) &&
        (!('paymentDueDay' in data) || data.paymentDueDay == null) &&
        (!('mirror' in data) || data.mirror == null) &&
        data.currency is string &&
        data.pocketActivity is bool && data.pocketActivity == isFunded &&
        data.openingAllocationId == (isFunded ? data.openingAllocationId : null) &&
        (!isFunded || data.openingAllocationId is string) &&
        (!('childAccountIds' in data) || (data.childAccountIds is list && data.childAccountIds.size() == 0)) &&
        !('lastPocketMovementId' in data) && !('lastPocketMovementType' in data) &&
        data.createdAt is timestamp &&
        parent != null && parentAfter != null &&
        parent.data.workspaceId == data.workspaceId &&
        parent.data.type in ['checking', 'savings'] && hasNoParent(parent.data) &&
        (!('mirror' in parent.data) || parent.data.mirror == null) &&
        parent.data.currency == data.currency &&
        isFiniteNumber(parent.data.balance) && parent.data.balance >= amount &&
        validChildIds(childIds(parent.data)) &&
        validChildIds(childIds(parentAfter.data)) &&
        accountId in childIds(parentAfter.data) &&
        parentAfter.data.lastPocketChildId == accountId &&
        parentAfter.data.lastPocketChange == 'created' &&
        (isFunded
          ? parentAfter.data.balance == parent.data.balance - amount &&
            validPocketOpeningLink(data.openingAllocationId, parentId, accountId, amount, data.workspaceId, data.currency)
          : amount == 0 && data.openingAllocationId == null && data.pocketActivity == false &&
            parentAfter.data.balance == parent.data.balance);
    }

    function validPocketAddition(accountId, oldIds, newIds, changed) {
      let childId = request.resource.data.lastPocketChildId;
      let child = getAfter(accountPath(childId));
      let amount = child.data.balance;
      let isFunded = amount > 0;
      return request.resource.data.lastPocketChange == 'created' &&
        childId is string && childId in newIds && !(childId in oldIds) &&
        newIds.size() == oldIds.size() + 1 && newIds.hasAll(oldIds) &&
        validChildIds(newIds) &&
        changed.hasOnly(['balance', 'childAccountIds', 'lastPocketChildId', 'lastPocketChange']) &&
        child != null && child.data.parentAccountId == accountId &&
        child.data.workspaceId == resource.data.workspaceId &&
        child.data.currency == resource.data.currency &&
        child.data.type == 'savings' && isFiniteNumber(amount) && amount >= 0 &&
        (isFunded
          ? request.resource.data.balance == resource.data.balance - amount && resource.data.balance >= amount &&
            child.data.openingAllocationId is string &&
            validPocketOpeningLink(child.data.openingAllocationId, accountId, childId, amount, resource.data.workspaceId, resource.data.currency)
          : amount == 0 && request.resource.data.balance == resource.data.balance &&
            child.data.openingAllocationId == null && child.data.pocketActivity == false);
    }

    function validPocketRemoval(accountId, oldIds, newIds, changed) {
      let childId = request.resource.data.lastPocketChildId;
      let child = get(accountPath(childId));
      let childAfter = getAfter(accountPath(childId));
      return request.resource.data.lastPocketChange == 'deleted' &&
        childId is string && childId in oldIds && !(childId in newIds) &&
        oldIds.size() == newIds.size() + 1 && oldIds.hasAll(newIds) &&
        validChildIds(newIds) &&
        changed.hasOnly(['childAccountIds', 'lastPocketChildId', 'lastPocketChange']) &&
        child != null && childAfter == null &&
        child.data.parentAccountId == accountId &&
        child.data.workspaceId == resource.data.workspaceId &&
        child.data.currency == resource.data.currency &&
        child.data.balance == 0 && child.data.pocketActivity == false &&
        child.data.openingAllocationId == null &&
        request.resource.data.balance == resource.data.balance;
    }

    function validRootAccountUpdate(accountId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldIds = childIds(resource.data);
      let newIds = childIds(request.resource.data);
      let registryChanged = changed.hasAny(['childAccountIds', 'lastPocketChildId', 'lastPocketChange']);
      let movementChanged = changed.hasAny(['lastPocketMovementId', 'lastPocketMovementType']);
      return hasNoParent(resource.data) && hasNoParent(request.resource.data) &&
        !changed.hasAny(['parentAccountId']) &&
        !('pocketActivity' in request.resource.data) &&
        !('openingAllocationId' in request.resource.data) &&
        (oldIds.size() == 0 || request.resource.data.workspaceId == resource.data.workspaceId) &&
        validChildIds(oldIds) && validChildIds(newIds) &&
        (oldIds.size() == 0 ||
          (request.resource.data.type == resource.data.type &&
           request.resource.data.currency == resource.data.currency &&
           (!('mirror' in request.resource.data) || request.resource.data.mirror == null) &&
           (!('mirror' in resource.data) || resource.data.mirror == null))) &&
        (registryChanged
          ? validPocketAddition(accountId, oldIds, newIds, changed) ||
            validPocketRemoval(accountId, oldIds, newIds, changed)
          : oldIds.size() == newIds.size() && newIds.hasAll(oldIds) && oldIds.hasAll(newIds) &&
            (movementChanged
              ? validPocketMovementAccount(accountId)
              : oldIds.size() == 0 || request.resource.data.balance == resource.data.balance));
    }

    function validPocketUpdate(accountId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let nameOnly = changed.hasOnly(['name']);
      return request.resource.data.parentAccountId == resource.data.parentAccountId &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.type == 'savings' && resource.data.type == 'savings' &&
        request.resource.data.limit == resource.data.limit &&
        (request.resource.data.openingAllocationId == resource.data.openingAllocationId ||
          (request.resource.data.openingAllocationId == null &&
           resource.data.openingAllocationId == request.resource.data.lastPocketMovementId &&
           request.resource.data.lastPocketMovementType == 'deleted')) &&
        (!('mirror' in request.resource.data) || request.resource.data.mirror == null) &&
        (nameOnly
          ? request.resource.data.balance == resource.data.balance &&
            request.resource.data.pocketActivity == resource.data.pocketActivity
          : validPocketMovementAccount(accountId));
    }

    function validPocketDelete(accountId) {
      let parentId = resource.data.parentAccountId;
      let parentAfter = getAfter(accountPath(parentId));
      return parentId is string &&
        resource.data.balance == 0 &&
        resource.data.pocketActivity == false &&
        resource.data.openingAllocationId == null &&
        parentAfter != null &&
        parentAfter.data.workspaceId == resource.data.workspaceId &&
        !(accountId in childIds(parentAfter.data)) &&
        parentAfter.data.lastPocketChildId == accountId &&
        parentAfter.data.lastPocketChange == 'deleted';
    }

    function normalTransactionReferencesRoots(data) {
      return data.accountId is string && rootAccountForWorkspace(data.accountId, data.workspaceId) &&
        !('pocketAllocation' in data) &&
        (data.toAccountId == null ||
          (data.toAccountId is string && rootAccountForWorkspace(data.toAccountId, data.workspaceId)));
    }

    function safeExistingTransactionReferencesNoPocket(data) {
      let sourceExists = exists(accountPath(data.accountId));
      let destinationExists = data.toAccountId is string && exists(accountPath(data.toAccountId));
      return (!sourceExists || rootAccountForWorkspace(data.accountId, data.workspaceId)) &&
        (!destinationExists || rootAccountForWorkspace(data.toAccountId, data.workspaceId));
    }

    function validMovementChildEndpoint(accountId, workspaceId, data) {
      let parent = get(accountPath(data.parentAccountId));
      return data.parentAccountId is string && data.type == 'savings' && parent != null &&
        parent.data.workspaceId == workspaceId && parent.data.type in ['checking', 'savings'] &&
        hasNoParent(parent.data) && (!('mirror' in parent.data) || parent.data.mirror == null) &&
        parent.data.currency == data.currency && accountId in childIds(parent.data) &&
        validChildIds(childIds(parent.data)) && childIds(data).size() == 0;
    }

    function validMovementEndpointData(accountId, workspaceId, data) {
      return data.workspaceId == workspaceId && data.type in ['checking', 'savings', 'cash'] &&
        (!('mirror' in data) || data.mirror == null) &&
        (hasNoParent(data)
          ? validChildIds(childIds(data))
          : validMovementChildEndpoint(accountId, workspaceId, data));
    }

    function transactionDeltaForAccount(data, accountId) {
      let sourceDelta = 'accountId' in data && data.accountId == accountId
        ? (data.type == 'transfer' ? -data.amount : data.amount)
        : 0;
      let destinationDelta = 'accountId' in data && data.type == 'transfer' && data.toAccountId == accountId ? data.amount : 0;
      return sourceDelta + destinationDelta;
    }

    function validPocketTransferShape(data, workspaceId, source) {
      let destination = get(accountPath(data.toAccountId));
      return data.toAccountId is string && data.accountId != data.toAccountId &&
        isFiniteNumber(data.amount) && data.amount > 0 && destination != null &&
        destination.data.currency == source.data.currency &&
        validMovementEndpointData(data.toAccountId, workspaceId, destination.data);
    }

    function validPocketMovementShape(data, workspaceId) {
      let source = get(accountPath(data.accountId));
      let validCashflow = (data.type == 'income' && isFiniteNumber(data.amount) && data.amount > 0 && data.toAccountId == null) ||
        (data.type == 'expense' && isFiniteNumber(data.amount) && data.amount < 0 && data.toAccountId == null);
      return data.workspaceId == workspaceId && data.userId is string && data.userId.size() > 0 &&
        data.accountId is string && source != null && validMovementEndpointData(data.accountId, workspaceId, source.data) &&
        source.data.currency is string &&
        data.currency == source.data.currency &&
        (data.type == 'transfer'
          ? validPocketTransferShape(data, workspaceId, source)
          : validCashflow) &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 500 &&
        data.categoryId is string && data.date is timestamp && data.createdAt is timestamp &&
        (!('mirrorOf' in data) || data.mirrorOf == null);
    }

    // Persistent movement markers are not proof; changed transaction deltas need current balance effects.
    function validMovementLinkedAccount(accountId, beforeData, afterData, transactionId, operation) {
      let accountBefore = get(accountPath(accountId));
      let accountAfter = getAfter(accountPath(accountId));
      return accountBefore != null && accountAfter != null &&
        accountAfter.data.balance != accountBefore.data.balance &&
        ((hasNoParent(accountAfter.data) && childIds(accountAfter.data).size() == 0) ||
         (accountAfter.data.lastPocketMovementId == transactionId &&
          accountAfter.data.lastPocketMovementType == operation));
    }

    function validPocketMovementCreate(transactionId, data) {
      return !('pocketAllocation' in data) &&
        validMovementLinkedAccount(data.accountId, {}, data, transactionId, 'created') &&
        (data.type != 'transfer' || validMovementLinkedAccount(data.toAccountId, {}, data, transactionId, 'created')) &&
        validPocketMovementShape(data, data.workspaceId);
    }

    function validExistingPocketMovement(data) {
      let validTransfer = data.type == 'transfer' && data.toAccountId is string &&
        data.accountId != data.toAccountId && isFiniteNumber(data.amount) && data.amount > 0;
      let validCashflow = (data.type == 'income' && isFiniteNumber(data.amount) && data.amount > 0 && data.toAccountId == null) ||
        (data.type == 'expense' && isFiniteNumber(data.amount) && data.amount < 0 && data.toAccountId == null);
      return (validTransfer || validCashflow) && (!('mirrorOf' in data) || data.mirrorOf == null);
    }

    function validPocketOpeningUpdate(transactionId, beforeData, afterData) {
      return afterData.pocketAllocation == true &&
        beforeData.workspaceId == afterData.workspaceId &&
        beforeData.createdAt == afterData.createdAt &&
        beforeData.type == 'transfer' && afterData.type == 'transfer' &&
        beforeData.accountId == afterData.accountId &&
        beforeData.toAccountId == afterData.toAccountId &&
        afterData.accountId != afterData.toAccountId &&
        isFiniteNumber(afterData.amount) && afterData.amount > 0 &&
        beforeData.currency == afterData.currency && afterData.categoryId == '' &&
        afterData.userId is string && afterData.userId.size() > 0 &&
        afterData.description is string && afterData.description.size() > 0 && afterData.description.size() <= 500 &&
        afterData.date is timestamp &&
        afterData.diff(beforeData).affectedKeys().hasOnly([
          'amount', 'description', 'categoryId', 'date', 'receiptUrl', 'notes', 'installments', 'userId'
        ]) &&
        (beforeData.amount == afterData.amount ||
          (validMovementLinkedAccount(beforeData.accountId, beforeData, afterData, transactionId, 'updated') &&
           validMovementLinkedAccount(beforeData.toAccountId, beforeData, afterData, transactionId, 'updated')));
    }

    // Account rules validate each posted delta; pair conservation rejects a one-sided transfer edit.
    function validPocketTransferPairConserved(beforeData, afterData) {
      let sourceBefore = get(accountPath(beforeData.accountId));
      let destinationBefore = get(accountPath(beforeData.toAccountId));
      let sourceAfter = getAfter(accountPath(afterData.accountId));
      let destinationAfter = getAfter(accountPath(afterData.toAccountId));
      return sourceBefore != null && destinationBefore != null && sourceAfter != null && destinationAfter != null &&
        sourceBefore.data.balance + destinationBefore.data.balance ==
        sourceAfter.data.balance + destinationAfter.data.balance;
    }

    function validPocketMovementUpdate(transactionId, beforeData, afterData) {
      let sameTransferPair = beforeData.type == 'transfer' && afterData.type == 'transfer' &&
        ((beforeData.accountId == afterData.accountId && beforeData.toAccountId == afterData.toAccountId) ||
         (beforeData.accountId == afterData.toAccountId && beforeData.toAccountId == afterData.accountId));
      let noDeltaChange = beforeData.accountId == afterData.accountId &&
        beforeData.type == afterData.type && beforeData.amount == afterData.amount &&
        (beforeData.type != 'transfer' || beforeData.toAccountId == afterData.toAccountId);
      return ('pocketAllocation' in beforeData && beforeData.pocketAllocation == true)
        ? validPocketOpeningUpdate(transactionId, beforeData, afterData)
        : beforeData.workspaceId == afterData.workspaceId &&
        beforeData.createdAt == afterData.createdAt &&
        afterData.diff(beforeData).affectedKeys().hasOnly([
          'accountId', 'amount', 'description', 'categoryId', 'date', 'type', 'toAccountId',
          'receiptUrl', 'notes', 'installments', 'userId', 'currency', 'statementImportId'
        ]) &&
        validExistingPocketMovement(beforeData) &&
        (noDeltaChange ||
          (validMovementLinkedAccount(beforeData.accountId, beforeData, afterData, transactionId, 'updated') &&
           (sameTransferPair
             ? validPocketTransferPairConserved(beforeData, afterData)
             : (beforeData.type != 'transfer' || validMovementLinkedAccount(beforeData.toAccountId, beforeData, afterData, transactionId, 'updated')) &&
               (afterData.accountId == beforeData.accountId ||
                 (beforeData.type == 'transfer' && afterData.accountId == beforeData.toAccountId) ||
                 validMovementLinkedAccount(afterData.accountId, beforeData, afterData, transactionId, 'updated')) &&
               (afterData.type != 'transfer' || afterData.toAccountId == beforeData.accountId ||
                 (beforeData.type == 'transfer' && afterData.toAccountId == beforeData.toAccountId) ||
                 validMovementLinkedAccount(afterData.toAccountId, beforeData, afterData, transactionId, 'updated'))))) &&
        validPocketMovementShape(afterData, afterData.workspaceId);
    }

    function validPocketMovementDelete(transactionId, data) {
      return validMovementLinkedAccount(data.accountId, data, {}, transactionId, 'deleted') &&
        (data.type != 'transfer' || validMovementLinkedAccount(data.toAccountId, data, {}, transactionId, 'deleted')) &&
        validPocketMovementShape(data, data.workspaceId);
    }

    function validPocketMovementAccount(accountId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let transactionId = request.resource.data.lastPocketMovementId;
      let operation = request.resource.data.lastPocketMovementType;
      let beforeTransaction = get(transactionPath(transactionId));
      let afterTransaction = getAfter(transactionPath(transactionId));
      let beforeData = beforeTransaction == null ? {} : beforeTransaction.data;
      let afterData = afterTransaction == null ? {} : afterTransaction.data;
      let beforeDelta = transactionDeltaForAccount(beforeData, accountId);
      let afterDelta = transactionDeltaForAccount(afterData, accountId);
      let netDelta = afterDelta - beforeDelta;
      return transactionId is string && operation in ['created', 'updated', 'deleted'] &&
        changed.hasOnly(['balance', 'pocketActivity', 'lastPocketMovementId', 'lastPocketMovementType', 'openingAllocationId']) &&
        ((operation == 'created' && !('accountId' in beforeData) && 'accountId' in afterData) ||
         (operation == 'updated' && 'accountId' in beforeData && 'accountId' in afterData) ||
         (operation == 'deleted' && 'accountId' in beforeData && !('accountId' in afterData))) &&
        request.resource.data.balance == resource.data.balance + netDelta &&
        (!changed.hasAny(['openingAllocationId']) ||
          (operation == 'deleted' && beforeData.pocketAllocation == true &&
           beforeData.toAccountId == accountId && resource.data.openingAllocationId == transactionId &&
           request.resource.data.openingAllocationId == null)) &&
        (netDelta == 0
          ? request.resource.data.lastPocketMovementId == transactionId &&
            request.resource.data.lastPocketMovementType == operation &&
            (!('parentAccountId' in resource.data && resource.data.parentAccountId is string) || request.resource.data.pocketActivity == true)
          : request.resource.data.lastPocketMovementId == transactionId &&
            request.resource.data.lastPocketMovementType == operation &&
            (!('parentAccountId' in resource.data && resource.data.parentAccountId is string) || request.resource.data.pocketActivity == true) &&
            (!(('parentAccountId' in resource.data && resource.data.parentAccountId is string) || childIds(resource.data).size() > 0) ||
              request.resource.data.balance >= 0));
    }

    function validPocketOpeningTransaction(transactionId) {
      let data = request.resource.data;
      let parentId = data.accountId;
      let childId = data.toAccountId;
      let parent = get(accountPath(parentId));
      let parentAfter = getAfter(accountPath(parentId));
      let childAfter = getAfter(accountPath(childId));
      return data.pocketAllocation == true &&
        data.type == 'transfer' && data.workspaceId is string &&
        data.userId == request.auth.uid &&
        data.accountId is string && data.toAccountId is string && data.accountId != data.toAccountId &&
        isFiniteNumber(data.amount) && data.amount > 0 &&
        data.categoryId == '' && data.currency is string &&
        data.description is string && data.date is timestamp && data.createdAt is timestamp &&
        parent != null && parentAfter != null && childAfter != null &&
        parent.data.workspaceId == data.workspaceId && parent.data.currency == data.currency &&
        parent.data.type in ['checking', 'savings'] && hasNoParent(parent.data) &&
        (!('mirror' in parent.data) || parent.data.mirror == null) &&
        parent.data.balance >= data.amount &&
        parentAfter.data.balance == parent.data.balance - data.amount &&
        parentAfter.data.lastPocketChildId == childId && parentAfter.data.lastPocketChange == 'created' &&
        childId in childIds(parentAfter.data) &&
        childAfter.data.parentAccountId == parentId &&
        childAfter.data.workspaceId == data.workspaceId &&
        childAfter.data.currency == data.currency &&
        childAfter.data.balance == data.amount &&
        childAfter.data.pocketActivity == true &&
        childAfter.data.openingAllocationId == transactionId;
    }

    // A profile is readable by its owner, or by a member of the requester's active
    // workspace when the target is also a member. activeWorkspaceId is self-writable,
    // so membership of both users is checked against the workspace document itself.
    function sharesActiveWorkspace(userId) {
      let requester = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let workspaceId = requester == null ? null : requester.data.get('activeWorkspaceId', null);
      let workspace = workspaceId is string
        ? get(/databases/$(database)/documents/workspaces/$(workspaceId))
        : null;
      return workspace != null &&
        request.auth.uid in workspace.data.members &&
        userId in workspace.data.members;
    }

    // Workspace fields members may edit from the client. members/ownerId only change
    // through Cloud Functions (Admin SDK).
    function workspaceSettingsKeys() {
      return [
        'expenseLimit', 'budgetIncome', 'budgetNeedsPercent', 'budgetWantsPercent',
        'budgetSavingsPercent', 'budgetAllocations', 'categoryBudgets', 'exchangeRates',
        'budgetAlertsEnabled'
      ];
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || (isAuthenticated() && sharesActiveWorkspace(userId));
      allow write: if isOwner(userId);

      match /secure/{documentId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /workspaces/{workspaceId} {
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.members == [request.auth.uid];
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(workspaceSettingsKeys());
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /accounts/{accountId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId) &&
        (hasNoParent(request.resource.data)
          ? ((!('childAccountIds' in request.resource.data) ||
              (request.resource.data.childAccountIds is list && request.resource.data.childAccountIds.size() == 0)) &&
             !('pocketActivity' in request.resource.data) &&
             !('openingAllocationId' in request.resource.data) &&
             !('lastPocketChildId' in request.resource.data) &&
             !('lastPocketChange' in request.resource.data) &&
             !('lastPocketMovementId' in request.resource.data) &&
             !('lastPocketMovementType' in request.resource.data))
          : validPocketCreate(accountId));
      allow update: if isWorkspaceMember(resource.data.workspaceId) &&
        (hasNoParent(resource.data) ? validRootAccountUpdate(accountId) : validPocketUpdate(accountId));
      allow delete: if isWorkspaceMember(resource.data.workspaceId) &&
        (hasNoParent(resource.data)
          ? validChildIds(childIds(resource.data)) && childIds(resource.data).size() == 0
          : validPocketDelete(accountId));
    }

    match /transactions/{transactionId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId) &&
        (normalTransactionReferencesRoots(request.resource.data) ||
         validPocketMovementCreate(transactionId, request.resource.data) ||
         validPocketOpeningTransaction(transactionId));
      allow update: if isWorkspaceMember(resource.data.workspaceId) &&
        isWorkspaceMember(request.resource.data.workspaceId) &&
        ((safeExistingTransactionReferencesNoPocket(resource.data) &&
          safeExistingTransactionReferencesNoPocket(request.resource.data)) ||
         validPocketMovementUpdate(transactionId, resource.data, request.resource.data));
      allow delete: if isWorkspaceMember(resource.data.workspaceId) &&
        (safeExistingTransactionReferencesNoPocket(resource.data) ||
         validPocketMovementDelete(transactionId, resource.data));
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated() &&
        (resource.data.workspaceId == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    match /goals/{goalId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    match /chats/{chatId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if isWorkspaceMember(resource.data.workspaceId);
    }

    // Statement import idempotency markers are written and read only by Cloud Functions.
    match /statementImports/{markerId} {
      allow read, write: if false;
    }

    // Server-only daily default-key usage counters (written by functions via Admin SDK).
    match /usageQuotas/{quotaId} {
      allow read, write: if false;
    }

    // Server-only semantic vectors (written by the embedding trigger / backfill script).
    match /transactionEmbeddings/{transactionId} {
      allow read, write: if false;
    }

    // Server-only budget alert dedupe ledger (written by the notifyBudgetThreshold trigger).
    match /budgetAlerts/{alertId} {
      allow read, write: if false;
    }
  }
}
