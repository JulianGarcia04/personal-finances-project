# Emulator-only environment for tests/functions.http.emulators.mjs.
# Copied as `.env` into a throwaway functions source; never contains real secrets.
ENCRYPTION_SECRET=emulator-only-encryption-secret-32chars
# Dummy default key: quota limits of 0 reject default-key requests before Gemini runs.
GEMINI_API_KEY=emulator-only-dummy-gemini-key
DEFAULT_KEY_DAILY_CHAT_LIMIT=0
DEFAULT_KEY_DAILY_PARSE_LIMIT=0
