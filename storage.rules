rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Función auxiliar para comprobar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar para comprobar si pertenece al usuario (perfiles, etc)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Función auxiliar para comprobar si pertenece al workspace (lee desde Firestore)
    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && 
             request.auth.uid in firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.members;
    }

    // Uploads must be a receipt (image or PDF) below the 5 MB limit enforced by the UI.
    function isValidReceiptUpload() {
      return request.resource.size < 5 * 1024 * 1024 &&
             (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType == 'application/pdf');
    }

    // Permitir lectura y escritura solo en el subdirectorio del propio usuario (legado o data personal)
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidReceiptUpload();
    }

    // Lectura y borrado en todo el directorio del workspace (incluye archivos legados)
    match /workspaces/{workspaceId}/{allPaths=**} {
      allow read, delete: if isWorkspaceMember(workspaceId);
    }

    // Las subidas del workspace solo se permiten como comprobantes
    match /workspaces/{workspaceId}/receipts/{fileName} {
      allow create, update: if isWorkspaceMember(workspaceId) && isValidReceiptUpload();
    }
  }
}
